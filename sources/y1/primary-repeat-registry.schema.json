{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gnomad.broadinstitute.org/schemas/y1-primary-repeat-registry-v1.json",
  "title": "Y1 receipt-bound primary-repeat registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract", "release", "reference_genome",
    "source_inventory_sha256", "approval_state", "design_authorization_receipt",
    "entries", "content_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "contract": { "const": "Y1_PRIMARY_REPEAT_REGISTRY_V1" },
    "release": { "const": "Y1" },
    "reference_genome": { "const": "GRCh38" },
    "source_inventory_sha256": { "$ref": "#/$defs/sha256" },
    "approval_state": { "$ref": "#/$defs/approvalState" },
    "design_authorization_receipt": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    },
    "content_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "approvalState": {
      "enum": ["CANDIDATE_PENDING_SCIENCE", "REVIEWED"]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start0", "end0", "motif"],
      "properties": {
        "start0": { "type": "integer", "minimum": 0 },
        "end0": { "type": "integer", "minimum": 1 },
        "motif": { "type": "string", "pattern": "^[ACGT]+$" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_entry_id", "catalog_id", "canonical_locus_id", "source_variant_id",
        "chrom", "source_position", "ordered_components", "component_index", "motif",
        "selection_basis", "biological_role", "approval_state", "reviewer",
        "approval_receipt", "catalog_digest"
      ],
      "properties": {
        "registry_entry_id": { "type": "string", "minLength": 1 },
        "catalog_id": { "type": "string", "minLength": 1 },
        "canonical_locus_id": { "type": "string", "minLength": 1 },
        "source_variant_id": { "type": "string", "minLength": 1 },
        "chrom": { "type": "string", "pattern": "^chr([1-9]|1[0-9]|2[0-2]|X|Y)$" },
        "source_position": { "type": "integer", "minimum": 1 },
        "ordered_components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } },
        "component_index": { "type": "integer", "minimum": 0 },
        "motif": { "type": "string", "pattern": "^[ACGT]+$" },
        "selection_basis": {
          "enum": ["EXACT_MAIN_CATALOG_COMPONENT", "LR_SOLE_COMPONENT", "REVIEWED_PRIMARY_REPEAT_REGISTRY"]
        },
        "biological_role": { "type": ["string", "null"] },
        "approval_state": { "$ref": "#/$defs/approvalState" },
        "reviewer": { "type": ["string", "null"] },
        "approval_receipt": { "type": ["string", "null"] },
        "catalog_digest": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    }
  }
}
